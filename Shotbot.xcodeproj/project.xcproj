{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/Rspoon3/AsyncTimelineProvider.git",
      "version": {
        "version": "1.0.0",
      },
    },
  ],
  "files": [
    { "path": "ShotbotCore" },
    {
      "kind": "group",
      "path": "Shotbot",
      "children": [
        { "path": "Shotbot.entitlements" },
        { "path": "ShotbotApp.swift", "target-membership": [ "Shotbot/compile-sources" ] },
        { "path": "AppDelegateAdaptor.swift", "target-membership": [ "Shotbot/compile-sources" ] },
        {
          "kind": "group",
          "path": "Shortcuts",
          "children": [
            { "path": "CreateFramedScreenshotsIntent.swift", "target-membership": [ "Shotbot/compile-sources" ] },
            { "path": "ShortcutsImageQuality.swift", "target-membership": [ "Shotbot/compile-sources" ] },
            { "path": "ShotBotShortcuts.swift", "target-membership": [ "Shotbot/compile-sources" ] },
          ],
        },
        { "path": "Info.plist", "encoding": "utf8" },
        {
          "path": "Assets.xcassets",
          "target-membership": [
            "Shotbot/resources",
            "WidgetsExtension/resources",
          ],
        }, {
          "kind": "group",
          "path": "Preview Content",
          "children": [
            { "path": "Preview Assets.xcassets", "target-membership": [ "Shotbot/resources" ] },
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "ShotbotActionExtension",
      "children": [
        { "path": "ShotbotActionExtension.entitlements" },
        { "path": "ActionExtensionView.swift", "encoding": "utf8", "target-membership": [ "ShotbotActionExtension/compile-sources" ] },
        { "path": "ActionExtensionMainContentView.swift", "target-membership": [ "ShotbotActionExtension/compile-sources" ] },
        { "path": "ActionExtensionViewModel.swift", "encoding": "utf8", "target-membership": [ "ShotbotActionExtension/compile-sources" ] },
        { "path": "ActionViewController.swift", "encoding": "utf8", "target-membership": [ "ShotbotActionExtension/compile-sources" ] },
        { "path": "Info.plist", "encoding": "utf8" },
        { "path": "Assets.xcassets", "target-membership": [ "ShotbotActionExtension/resources" ] },
      ],
    }, {
      "kind": "group",
      "path": "Widgets",
      "children": [
        {
          "kind": "group",
          "path": "Preview Content",
          "children": [
            { "path": "Preview Assets.xcassets", "target-membership": [ "WidgetsExtension/resources" ] },
          ],
        },
        { "path": "WidgetsBundle.swift", "target-membership": [ "WidgetsExtension/compile-sources" ] },
        {
          "kind": "folder",
          "path": "FramedScreenshotsControlWidget",
          "target-membership": [
            "WidgetsExtension",
          ],
          "membership-exceptions": [
            {
              "target": "Shotbot",
              "inclusions": [
                "ConfigurableProvider.swift",
                "FramedScreenshotsControlWidget.swift",
                "ScreenshotTimeIntervalEntity.swift",
                "SelectScreenshotTimeIntervalIntent.swift",
              ],
            },
          ],
        }, {
          "kind": "group",
          "path": "MultipleScreenshotsProvider",
          "children": [
            { "path": "MultipleScreenshotsProvider.swift", "target-membership": [ "WidgetsExtension/compile-sources" ] },
            { "path": "MultipleScreenshotsView.swift", "target-membership": [ "WidgetsExtension/compile-sources" ] },
            { "path": "MultipleScreenshotsEntry.swift", "target-membership": [ "WidgetsExtension/compile-sources" ] },
            { "path": "MultipleScreenshotsWidget.swift", "target-membership": [ "WidgetsExtension/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "LatestScreenshotWidget",
          "children": [
            { "path": "LatestScreenshotProvider.swift", "target-membership": [ "WidgetsExtension/compile-sources" ] },
            { "path": "LatestScreenshotView.swift", "target-membership": [ "WidgetsExtension/compile-sources" ] },
            { "path": "AdaptiveLabelStyle.swift", "target-membership": [ "WidgetsExtension/compile-sources" ] },
            {
              "kind": "group",
              "path": "Intents",
              "children": [
                { "path": "DeleteLatestScreenshotIntent.swift", "target-membership": [ "WidgetsExtension/compile-sources" ] },
                { "path": "RefreshLatestScreenshotIntent.swift", "target-membership": [ "WidgetsExtension/compile-sources" ] },
              ],
            },
            { "path": "LatestScreenshotEntry.swift", "target-membership": [ "WidgetsExtension/compile-sources" ] },
            { "path": "LatestScreenshotWidget.swift", "target-membership": [ "WidgetsExtension/compile-sources" ] },
          ],
        }, {
          "kind": "group",
          "path": "Extensions",
          "children": [
            { "path": "CGSize+Extension.swift", "target-membership": [ "WidgetsExtension/compile-sources" ] },
          ],
        },
        { "path": "Assets.xcassets", "target-membership": [ "WidgetsExtension/resources" ] },
        { "path": "Info.plist" },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Shotbot.app", "id": "94BD65C62A44B28700D0CE61", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/ShotbotActionExtension.appex", "id": "94BD65E12A44B49900D0CE61", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Shotbot/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/WidgetsExtension.appex", "id": "94453E452C4AAD7800B15690", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Shotbot/copy/Embed Foundation Extensions", "platforms": [ "ios" ], "header-preservation": "remove-on-copy" } ] },
      ],
    }, {
      "kind": "group",
      "name": "Frameworks",
      "children": [
        { "path": "<SDK>/System/Library/Frameworks/UniformTypeIdentifiers.framework", "target-membership": [ "ShotbotActionExtension/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/WidgetKit.framework", "target-membership": [ "WidgetsExtension/frameworks" ] },
        { "path": "<SDK>/System/Library/Frameworks/SwiftUI.framework", "target-membership": [ "WidgetsExtension/frameworks" ] },
      ],
    },
  ],
  "targets": [
    {
      "name": "Shotbot",
      "id": "94BD65C52A44B28700D0CE61",
      "product": "Products/Shotbot.app",
      "product-type": "application",
      "dependencies": [
        "ShotbotActionExtension",
        { "target": "WidgetsExtension", "platforms": [ "ios" ] },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "AppFeature",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Shotbot/Shotbot.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "$(CURRENT_PROJECT_VERSION)",
        "DEAD_CODE_STRIPPING": "YES",
        "DEVELOPMENT_ASSET_PATHS": "\"Shotbot/Preview Content\"",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Shotbot/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Shotbot",
        "INFOPLIST_KEY_ITSAppUsesNonExemptEncryption": "NO",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.graphics-design",
        "INFOPLIST_KEY_NSPhotoLibraryUsageDescription": "Add and delete screenshots to your photo library",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown",
        "IPHONEOS_DEPLOYMENT_TARGET": "17.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "$(MARKETING_VERSION)",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.rspoon3.ShotbotFrames",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator xros xrsimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "YES",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
      },
    }, {
      "name": "ShotbotActionExtension",
      "id": "94BD65E02A44B49900D0CE61",
      "product": "Products/ShotbotActionExtension.appex",
      "product-type": "app-extension",
      "last-swift-migration": "14.3",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "CreateCombinedImageFeature",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "Models",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "Persistence",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "Purchases",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "SBFoundation",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "ActionIcon",
        "CLANG_ENABLE_MODULES": "YES",
        "CODE_SIGN_ENTITLEMENTS": "ShotbotActionExtension/ShotbotActionExtension.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "$(CURRENT_PROJECT_VERSION)",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "ShotbotActionExtension/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Create Framed Screenshot",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "IPHONEOS_DEPLOYMENT_TARGET": "17.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "MARKETING_VERSION": "$(MARKETING_VERSION)",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.rspoon3.ShotbotFrames.ShotbotActionExtension",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SKIP_INSTALL": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator xros xrsimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
      },
    }, {
      "name": "WidgetsExtension",
      "id": "94453E442C4AAD7800B15690",
      "product": "Products/WidgetsExtension.appex",
      "product-type": "app-extension",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "product-name": "AsyncTimelineProvider",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "MediaManager",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "product-name": "WidgetFeature",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "ASSETCATALOG_COMPILER_WIDGET_BACKGROUND_COLOR_NAME": "WidgetBackground",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "$(CURRENT_PROJECT_VERSION)",
        "DEVELOPMENT_ASSET_PATHS": "\"Widgets/Preview Content\"",
        "GCC_C_LANGUAGE_STANDARD": "gnu17",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Widgets/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Widgets",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "IPHONEOS_DEPLOYMENT_TARGET": "17.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
          "@executable_path/../../Frameworks",
        ],
        "LOCALIZATION_PREFERS_STRING_CATALOGS": "YES",
        "MARKETING_VERSION": "$(MARKETING_VERSION)",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.rspoon3.ShotbotFrames.Widgets",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SKIP_INSTALL": "YES",
        "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    },
  ],
